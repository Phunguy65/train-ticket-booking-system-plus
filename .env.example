# JWT
JWT_SECRET=your-jwt-secret-here-must-be-at-least-32-characters
JWT_ACCESS_TOKEN_EXPIRY=900
JWT_REFRESH_TOKEN_EXPIRY=604800

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SUCCESS_URL=http://localhost:3000/payment/success
STRIPE_CANCEL_URL=http://localhost:3000/payment/cancel

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Valkey (Redis-compatible)
VALKEY_HOST=localhost
VALKEY_PORT=6379

# RabbitMQ
# When running via docker-compose these are auto-configured by Spring Boot using
# SPRING_RABBITMQ_HOST / SPRING_RABBITMQ_PORT set directly in docker-compose.yml.
# Override here only when connecting to an external RabbitMQ instance.
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
