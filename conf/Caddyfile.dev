http://localhost:2015 {
	@notSSE not path /api/*/sse/*
	encode @notSSE gzip

	handle /slide-images/* {
		root * /srv
		file_server
	}

	handle /presentation.html {
		root * /srv
		file_server
	}

	handle /api/* {
		reverse_proxy backend:8080 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy customer:3000
	}
}
